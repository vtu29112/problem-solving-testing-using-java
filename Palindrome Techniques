class Solution {
    public int strStr(String haystack, String needle) {
        int n = haystack.length();
        int m = needle.length();

        // If needle is longer, it cannot exist in haystack
        if (m > n) {
            return -1;
        }

        for (int i = 0; i <= n - m; i++) {
            int j = 0;

            // Compare needle with substring starting at i
            while (j < m && haystack.charAt(i + j) == needle.charAt(j)) {
                j++;
            }

            // Entire needle matched
            if (j == m) {
                return i;
            }
        }

        return -1;
    }
}
